<Project Sdk="Microsoft.NET.Sdk">
  <!-- Arayüzsüz deneme aracı: görüntü boru hattını klasörler üzerinde çalıştırır. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>eokul-cli</AssemblyName>
    <RootNamespace>EOkulStudio.Cli</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\EOkulStudio.Core\EOkulStudio.Core.csproj" />
    <ProjectReference Include="..\EOkulStudio.Imaging\EOkulStudio.Imaging.csproj" />
    <ProjectReference Include="..\EOkulStudio.Infrastructure\EOkulStudio.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Fotograflari-isle.bat" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
  <Import Project="..\..\build\NativeDeps.targets" />
</Project>
