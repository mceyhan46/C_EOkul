<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>EOkulSpike</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
    <PackageReference Include="OpenCvSharp4" />
    <PackageReference Include="OpenCvSharp4.runtime.win" />
  </ItemGroup>
  <!-- Modeller ve ornek gorsel exe'nin icine gomulmez, yaninda durur. -->
  <ItemGroup>
    <Content Include="..\..\models\*.onnx;..\..\models\models.json" Link="models\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="samples\astronaut.png"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
  <!-- Kamera/video kullanılmadığı için FFmpeg eklentisi (LGPL, ~27 MB) pakete alınmaz. -->
  <Target Name="FfmpegCikar" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)"
                            Condition="$([System.String]::Copy('%(Filename)').StartsWith('opencv_videoio_ffmpeg'))" />
    </ItemGroup>
  </Target>
  <!-- ONNX Runtime paketinin .lib dosyaları yalnız C++ derlemesi içindir. -->
  <Target Name="LibDosyalariniSil" AfterTargets="Publish">
    <ItemGroup>
      <YayimLib Include="$(PublishDir)*.lib" />
    </ItemGroup>
    <Delete Files="@(YayimLib)" />
  </Target>
</Project>
